# Copy to .env.local and fill in values. Never commit .env.local.

# Required (see src/lib/env.ts)
DATABASE_URL=
RESEND_API_KEY=

# Optional Prisma (migrations / direct connection)
# DIRECT_URL=

# Public site URL (OG images, absolute asset URLs — use production URL on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Hero: cinematic still from e.g. Nano Banana — place file at public/images/hero/ambient.webp
# NEXT_PUBLIC_SHOW_HERO_AMBIENT=true
